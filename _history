{"entries":[{"timestamp":1795041980668,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":6110,"diffs":[[1,"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":133,"diffs":[[1,""]]},{"start1":1,"length1":1255,"diffs":[[1,""]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":245,"length1":31,"diffs":[[1,"    \"additionalFilePaths\": []\n"]]}]}]},{"timestamp":1795042422544,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":0,"diffs":[[1,"// Configurações do sensor\nlet limiteSeco = 400 // Ajuste este valor após calibrar com a terra seca e molhada\nlet leituraUmidade = 0\n\nbasic.forever(function () {\n    // 1. Liga a alimentação do sensor apenas no momento da leitura (evita ferrugem nos pregos)\n    pins.digitalWritePin(DigitalPin.P0, 1)\n    basic.pause(100) // Pequena pausa para estabilizar o sinal\n\n    // 2. Faz a leitura analógica no pino P1\n    leituraUmidade = pins.analogReadPin(AnalogPin.P1)\n\n    // 3. Desliga a alimentação imediatamente\n    pins.digitalWritePin(DigitalPin.P0, 0)\n\n    // 4. Verifica se a planta precisa de água\n    if (leituraUmidade < limiteSeco) {\n        // Terra seca: mostra um ícone de gota/alerta\n        basic.showIcon(IconNames.Umbrella)\n\n        // Toca um bipe suave de aviso (funciona no micro:bit V2)\n        music.playTone(523, music.beat(BeatFraction.Quarter))\n    } else {\n        // Terra úmida: mostra um rosto feliz ou coração\n        basic.showIcon(IconNames.Happy)\n    }\n\n    // Aguarda 5 segundos até a próxima verificação\n    basic.pause(5000)\n})\n\n// Botão A: Mostra o valor numérico exato da umidade na tela (útil para calibração)\ninput.onButtonPressed(Button.A, function () {\n    pins.digitalWritePin(DigitalPin.P0, 1)\n    basic.pause(100)\n    let valorAtual = pins.analogReadPin(AnalogPin.P1)\n    pins.digitalWritePin(DigitalPin.P0, 0)\n\n    basic.showNumber(valorAtual)\n})"]]}]}]},{"timestamp":1795043217035,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":689,"diffs":[[1,""]]}]}]},{"timestamp":1795043217910,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":445,"diffs":[[1,"let limiteSeco = 400\n"]]},{"start1":45,"length1":435,"diffs":[[1,""]]},{"start1":73,"length1":85,"diffs":[[1,""]]},{"start1":137,"length1":46,"diffs":[[1,""]]},{"start1":191,"length1":47,"diffs":[[1,""]]},{"start1":235,"length1":64,"diffs":[[1,"    // Envia os dados para o painel do PC via cabo USB\n"]]},{"start1":626,"length1":343,"diffs":[[1,"    basic.pause(2000) // Atualiza o painel a cada 2 segundos\n"]]}]}]},{"timestamp":1795043777956,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":7384,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"(J$,tly7^l=Mwn|52$oc\">leituraUmidade</variable><variable id=\"u,)rcG*4U2@uW{ND0cq4\">limiteSeco</variable><variable id=\"{Ea*XshvgSXIz0k)!8/R\">valorAtual</variable></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\"u,)rcG*4U2@uW{ND0cq4\">limiteSeco</field><comment pinned=\"false\" h=\"80\" w=\"160\">Configurações do sensor\nAjuste este valor após calibrar com a terra seca e molhada</comment><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">400</field></shadow></value></block></statement></block><block type=\"device_button_event\" x=\"397\" y=\"0\"><field name=\"NAME\">Button.A</field><comment pinned=\"false\" h=\"80\" w=\"160\">Botão A: Mostra o valor numérico exato da umidade na tela (útil para calibração)</comment><statement name=\"HANDLER\"><block typ